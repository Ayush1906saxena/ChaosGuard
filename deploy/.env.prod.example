# ============================================
# ChaosGuard Production Environment Variables
# ============================================
# Copy this to .env.prod and fill in your values

# === Database ===
POSTGRES_DB=chaosguard
POSTGRES_USER=chaosguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# === Security ===
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING_HERE

# === Frontend URL (your Vercel deployment) ===
FRONTEND_URL=https://chaosguard.vercel.app

# === GitHub (optional, for PR creation) ===
GITHUB_TOKEN=
