# ChaosGuard AI - Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env

# === Core Infrastructure ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chaosguard
POSTGRES_USER=chaosguard
POSTGRES_PASSWORD=your_postgres_password

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Ollama Models ===
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Ollama Performance (set these in your shell before running `ollama serve`) ===
# OLLAMA_MAX_LOADED_MODELS=3
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_FLASH_ATTENTION=1

# === Java Gateway ===
GATEWAY_PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/chaosguard
DATABASE_USER=chaosguard
DATABASE_PASSWORD=your_postgres_password
GITHUB_DEFAULT_TOKEN=  # Optional: GitHub token for PR creation

# === Python Services ===
INDEXER_PORT=8081
AGENTS_PORT=8082
MCP_PORT=5001

# === Frontend ===
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# === Scan Limits ===
MAX_REPO_SIZE_MB=500
MAX_FILE_COUNT=50000
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MINUTES=60

# === Chaos Safety Limits ===
# These control the safety boundaries for chaos engineering experiments.
# The agents service reads these at startup via SafetyLimits defaults.
CHAOS_MAX_BLAST_RADIUS=3          # Max containers affected simultaneously
CHAOS_MAX_DURATION_S=300           # Hard cap on experiment duration (seconds)
CHAOS_MAX_CONCURRENT=1             # Max concurrent chaos experiments
CHAOS_APPROVAL_TIMEOUT_S=600      # Time to wait for human approval (seconds)

# === Docker Socket Proxy ===
# The agents service connects to Docker through a socket proxy for security.
# Only change this if you are running the proxy on a custom host/port.
DOCKER_HOST=tcp://docker-proxy:2375

# === Kafka Topics ===
KAFKA_TOPIC_CLONE=repo-clone-events
KAFKA_TOPIC_INDEX=index-events
KAFKA_TOPIC_INDEX_COMPLETE=index-complete
KAFKA_TOPIC_SCAN_PROGRESS=scan-progress
KAFKA_TOPIC_SCAN_COMPLETE=scan-complete
KAFKA_TOPIC_RESULTS_READY=results-ready
